{
  "name": "docferry",
  "version": "0.0.66",
  "description": "Save public links as notes, publish secure notes, and unlock Pro folder sharing and media summaries.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "test": "node --import tsx --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mts"
  },
  "keywords": [
    "obsidian",
    "share",
    "publish",
    "markdown"
  ],
  "author": "Bondie",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "0.25.12",
    "obsidian": "1.13.0",
    "tsx": "4.23.12",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "cos-js-sdk-v5": "1.8.3"
  }
}
